# BotFather bergan token (masalan 123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx)
# Referral havolasi uchun bot username (@ belgisisiz, masalan: pravatezbot).
# Bo'sh qoldirilsa, foydalanuvchi faqat kodni ko'radi, havola ko'rsatilmaydi.
#
# MUHIM: havola https://t.me/<BOT_USERNAME>?startapp=... formatida quriladi
# (Telegramning rasmiy "Main Mini App" havolasi — core.telegram.org/bots/webapps).
# Bu ISHLASHI uchun BotFather'da: /mybots -> botingiz -> Bot Settings ->
# Menu Button (yoki Configure Mini App) -> "Web App" turi bilan sozlangan
# bo'lishi SHART. Agar Menu Button faqat oddiy URL (Web App emas) sifatida
# sozlangan bo'lsa, bu havola oddiy chatni ochadi, ilovani emas.
BOT_USERNAME=

BOT_TOKEN=

# JWT tokenlarni imzolash uchun tasodifiy uzun matn (masalan: openssl rand -hex 32)
JWT_SECRET=

# Admin bo'ladigan Telegram user ID'lar, vergul bilan ajratilgan
# Telegram ID'ingizni bilish uchun @userinfobot ga /start yozing
# Masalan: ADMIN_TELEGRAM_IDS=5842067106
ADMIN_TELEGRAM_IDS=

# PostgreSQL manzili — lokal ishga tushirishda docker-compose shu qiymatni beradi
DATABASE_URL="postgresql://tezprava:tezprava@localhost:5432/tezprava?schema=public"

PORT=3001
